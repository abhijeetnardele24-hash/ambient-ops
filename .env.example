# AmbientOps Environment Configuration Template
# Copy to .env and adjust as necessary for local development.

# Application Runtime
HOST=0.0.0.0
PORT=8000
ENVIRONMENT=development
CORS_ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
REQUEST_TIMEOUT_SECONDS=15.0

# AWS Bedrock Configuration (Optional)
# If left empty, AmbientOps automatically operates in deterministic-simulator mode
# with zero cloud bills and full offline verification.
AWS_REGION=us-east-1
BEDROCK_MODEL_ID=anthropic.claude-3-5-sonnet-20241022-v2:0
FORCE_BEDROCK_SIMULATOR=false

# Optional AWS Credentials (Uses standard boto3 credential chain if not set here)
# AWS_ACCESS_KEY_ID=your_aws_access_key_here
# AWS_SECRET_ACCESS_KEY=your_aws_secret_key_here
